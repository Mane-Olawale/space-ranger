// Release.xcconfig — optimised, symbolicated builds for Developer ID distribution (PLAN.md §6 Phase 5).

#include "Base.xcconfig"
#include "Signing.xcconfig"

SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited)
// Warnings stay visible but do not fail packaging builds (PLAN.md: warnings-as-errors is a Debug rule).
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
GCC_OPTIMIZATION_LEVEL = s
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_TESTABILITY = NO
ONLY_ACTIVE_ARCH = NO
COPY_PHASE_STRIP = NO
MTL_ENABLE_DEBUG_INFO = NO
ENABLE_NS_ASSERTIONS = NO
VALIDATE_PRODUCT = YES
