<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Reclaim.app entitlements (PLAN.md §6 Phase 5 "Entitlements"): hardened runtime only, no App Sandbox
	(ADR-001), no Apple Events automation (NSRunningApplication is used instead of AppleScript).
	Full Disk Access is a TCC grant, not an entitlement.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
