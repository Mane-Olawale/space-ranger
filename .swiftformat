# SwiftFormat configuration for Reclaim.
--swiftversion 6.0
--exclude Packages/ReclaimKit/.build,build,docs,Apps/Reclaim/Reclaim.xcodeproj

# Layout
--indent 4
--maxwidth 140
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--trimwhitespace always
--commas always
--ranges no-space
--semicolons inline
--linebreaks lf

# Style
--self remove
--importgrouping testable-last
--stripunusedargs closure-only
--ifdef no-indent
--elseposition same-line
--guardelse same-line
--extensionacl on-declarations
--patternlet hoist
--shortoptionals always
--emptybraces no-space
--header ignore

# Rules we do not want: compact single-line bodies are fine, and `attrgroup_t(x)` must not become `.init(x)`.
--disable wrapMultilineStatementBraces, redundantReturn, andOperator, blankLinesAtStartOfScope, \
          wrapIfStatementBodies, wrapLoopBodies, wrapPropertyBodies, wrapFunctionBodies, propertyTypes, redundantType
